<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>RuleEvaluator.Repository.Contract</PackageId>
    <Version>5.0.0</Version>
    <Authors>PajoCz</Authors>
    <Company>PajoCz</Company>
    <Description>Repository contracts for RuleEvaluator</Description>
    <PackageProjectUrl>https://github.com/PajoCz/RuleEvaluator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PajoCz/RuleEvaluator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RuleEvaluator\RuleEvaluator.csproj" />
  </ItemGroup>
</Project>
