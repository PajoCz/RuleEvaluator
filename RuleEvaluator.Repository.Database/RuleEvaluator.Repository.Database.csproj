<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>RuleEvaluator.Repository.Database</PackageId>
    <Version>5.0.0</Version>
    <Authors>PajoCz</Authors>
    <Company>PajoCz</Company>
    <Description>Database repository implementation for RuleEvaluator. Supports MSSQL and PostgreSQL.</Description>
    <PackageProjectUrl>https://github.com/PajoCz/RuleEvaluator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PajoCz/RuleEvaluator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>rule-evaluator;database;repository;mssql;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RuleEvaluator.Repository.Contract\RuleEvaluator.Repository.Contract.csproj" />
    <ProjectReference Include="..\RuleEvaluator\RuleEvaluator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="System.Runtime.Caching" Version="9.0.3" />
  </ItemGroup>
</Project>
